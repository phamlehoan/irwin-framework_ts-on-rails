NODE_ENV=development

PORT=8000

# Signing secrets. Required (>= 16 chars, not a placeholder) whenever APP_ENV/NODE_ENV is not development/test.
# Generate with: openssl rand -hex 32
JWT_SECRET=''
SESSION_SECRET=''



# ─── Chọn database ───────────────────────────────────────────────────────────

# 1) Sửa provider trong app/models/schema.prisma: "sqlite" | "postgresql"

# 2) Khớp biến env bên dưới. Chi tiết: docs/DATABASE.md

# 3) configs/db/migrations/migration_lock.toml — cùng provider với schema.prisma



# SQLite local (provider = "sqlite")

DATABASE_URL='file:./database/app.db'



# Turso — deploy SQLite lên cloud / Netlify (provider = "sqlite")

# TURSO_DATABASE_URL=libsql://your-db.turso.io

# TURSO_AUTH_TOKEN=



# Supabase — PostgreSQL (provider = "postgresql")

# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres



# Tuỳ chọn: ghi đè provider khi chạy migrate (mặc định đọc từ schema.prisma)

# DATABASE_PROVIDER=sqlite

# DATABASE_PROVIDER=postgresql



GOOGLE_CLIENT_ID=''

GOOGLE_CLIENT_SECRET=''

GOOGLE_REDIRECT_URI=''

GOOGLE_REFRESH_TOKEN=''

EMAIL_FROM=''



# Background jobs (optional)

# JOBS_USE_REDIS=false   # default: database queue, no Redis required

# JOBS_USE_REDIS=true    # BullMQ + Redis

# REDIS_HOST=127.0.0.1

# REDIS_PORT=6379



# Firebase Cloud Messaging (optional — mobile push via API)

FCM_PROJECT_ID=''

FCM_CLIENT_EMAIL=''

FCM_PRIVATE_KEY=''



# --- Hardening 1.2.x (every flag below restores the previous behaviour; defaults are the safe ones) ---
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=            # first admin only; unset = random one-time password printed by db:seed
# SEED_PRUNE=false                     # true = legacy seed that soft-deletes roles/features outside the built-in list
# CORS_ORIGIN=https://app.example      # comma separated; unset in production = no CORS headers
# CORS_ALLOW_ALL=false                 # true = legacy origin:true + credentials
# CSRF_PROTECTION=on                   # off = disable Origin/Referer check for cookie-session forms
# SESSION_SAMESITE=lax                 # lax | strict | none
# TRUST_PROXY=                         # hops (1), true, or CIDR list; required behind a load balancer
# RATE_LIMIT_REDIS_URL=                # share rate limits across instances
# RATE_LIMIT_AUTH_MAX=10               # login/register/refresh attempts per window per IP+account
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# REFRESH_MAX_SESSIONS=10              # devices per user
# REFRESH_SINGLE_DEVICE=false          # true = legacy one refresh token per user
# INVITE_TTL=72h
# RESET_TTL=1h
# INVITE_REUSE_STATUS=410              # 422 = legacy status when an invite link is reused
# AUTH_ALLOW_INACTIVE_USERS=false      # true = legacy: tokens of locked/deleted users keep working
# AUTH_LEGACY_403=false                # true = unauthenticated API requests answer 403 instead of 401
# API_PREFIX=/api
# PERMISSION_CACHE_TTL_MS=30000        # 0 = no permission cache
# REGISTRATION_ENABLED=true            # false = invite-only
# REGISTER_NEUTRAL_RESPONSE=false      # true = do not reveal whether an email is registered
# GOOGLE_SIGNUP_ROLE=                  # role code given to new Google sign-ups (unset = none)
# PASSWORD_MIN_LENGTH=8
# PROFILE_SELF_ROLE_EDIT=false         # true = legacy: users may change their own roles from /admin/me
# CLOUDINARY_UPLOAD_FOLDER=uploads
# SUPABASE_BUCKET=attachments
